// Land Intelligence OS - Prisma ORM Schema (Dual-Mode Operating System)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp", schema: "extensions")]
}

enum OrganizationOperatingMode {
  LAND_INVESTMENT
  LANDMAN_OPERATIONS
  DUAL_MODE
}

enum PropertyLifecycleStage {
  MARKET_DISCOVERY
  PARCEL_DISCOVERY
  PROSPECT
  CONTACTED
  QUALIFIED
  UNDERWRITING
  DUE_DILIGENCE
  OFFER_DRAFTED
  OFFER_SENT
  NEGOTIATION
  CONTRACTED
  CLOSING
  OWNED
  LISTED
  UNDER_CONTRACT_DISPOSITION
  SOLD
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

enum ESignatureStatus {
  NOT_SENT
  SENT
  DELIVERED
  SIGNED
  DECLINED
}

enum DiligenceCategory {
  TITLE_OWNERSHIP
  TAXES_LIENS
  LEGAL_ACCESS
  ZONING_RESTRICTIONS
  ENVIRONMENTAL_FLOOD
  UTILITIES_SEPTIC
  SURVEY_BOUNDARIES
  HOA_POA_FEES
  CLOSING_REQUIREMENTS
}

enum DiligenceStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED_BLOCKER
  EXEMPT
}

enum SellerMotivationLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PortfolioHoldingStatus {
  OWNED
  LISTED
  UNDER_CONTRACT
  SOLD
}

enum NoteStatus {
  ACTIVE
  PAID_IN_FULL
  DELINQUENT
  DEFAULTED
}

enum CommunicationChannel {
  EMAIL
  SMS
  PHONE
  DIRECT_MAIL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

// -------------------------------------------------------------
// LANDMAN OPERATING MODE ENUMS
// -------------------------------------------------------------

enum LandProjectType {
  MINERAL_OWNERSHIP_REPORT
  SURFACE_OWNERSHIP_REPORT
  LEASEHOLD_REPORT
  LEASE_ACQUISITION
  MINERAL_ACQUISITION
  RIGHT_OF_WAY_ACQUISITION
  SOLAR_DEVELOPMENT
  WIND_DEVELOPMENT
  BATTERY_STORAGE
  CARBON_CAPTURE
  TITLE_ABSTRACT
  CURATIVE_PROJECT
  DIVISION_ORDER_PAYDECK
}

enum LeaseholdStatus {
  OPEN_UNLEASED
  NEGOTIATING
  LEASED
  HELD_BY_PRODUCTION
  EXPIRED
}

enum HbpStatus {
  NOT_HBP
  CONFIRMED_HBP
  UNCERTAIN
  EXPIRED
}

enum TitleStatus {
  CLEAR
  DEFECTS_PENDING
  CURATIVE_REQUIRED
  ATTORNEY_REVIEW
}

enum InstrumentType {
  MINERAL_DEED
  WARRANTY_DEED
  QUITCLAIM_DEED
  OIL_GAS_LEASE
  MEMORANDUM_OF_LEASE
  ASSIGNMENT_OF_LEASE
  ROYALTY_DEED
  PROBATE_WILL
  AFFIDAVIT_OF_HEIRSHIP
  STIPULATION_OF_INTEREST
  RIGHT_OF_WAY_EASEMENT
  MORTGAGE_LIEN
}

enum CurativeSeverity {
  CRITICAL_BLOCKER
  MAJOR
  MINOR
}

enum CurativeStatus {
  OPEN
  DOCUMENT_REQUESTED
  IN_REVIEW
  CLEARED
}

enum EstateType {
  SURFACE_ESTATE
  MINERAL_ESTATE
  EXECUTIVE_RIGHTS
  ROYALTY_INTEREST
  NON_PARTICIPATING_ROYALTY
  OVERRIDING_ROYALTY
  WORKING_INTEREST
  LEASEHOLD_INTEREST
  OPERATING_RIGHTS
  WATER_RIGHTS
  PORE_SPACE
  SOLAR_RIGHTS
  WIND_RIGHTS
  RIGHT_OF_WAY
}

model Property {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @default("org_default") @map("organization_id")
  apn              String
  county           String
  state            String
  address          String?
  zipCode          String?                @map("zip_code")
  legalDescription String?                @map("legal_description")
  acreage          Float
  usableAcreage    Float                  @map("usable_acreage")
  lifecycleStage   PropertyLifecycleStage @default(PROSPECT) @map("lifecycle_stage")

  // Owner Details
  ownerName            String  @map("owner_name")
  mailingAddress       String? @map("mailing_address")
  mailingCityStateZip  String? @map("mailing_city_state_zip")
  absenteeOwner        Boolean @default(false) @map("absentee_owner")
  corporateOwner       Boolean @default(false) @map("corporate_owner")
  taxDelinquent        Boolean @default(false) @map("tax_delinquent")
  delinquentAmount     Float?  @map("delinquent_amount")
  ownershipLengthYears Float?  @map("ownership_length_years")

  // JSON Assessments
  accessAssessment        Json @default("{}") @map("access_assessment")
  zoningAssessment        Json @default("{}") @map("zoning_assessment")
  environmentalAssessment Json @default("{}") @map("environmental_assessment")
  utilityAssessment       Json @default("{}") @map("utility_assessment")

  // Geospatial Data
  centroidLat Float? @map("centroid_lat")
  centroidLng Float? @map("centroid_lng")
  rawGeometry Json?  @map("raw_geometry")

  // Financials & Valuation
  askingPrice          Float? @map("asking_price")
  estimatedMarketValue Float? @map("estimated_market_value")
  suggestedOfferPrice  Float? @map("suggested_offer_price")
  dealScore            Float? @map("deal_score")

  // Data Provenance
  provenance Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  comps             Comp[]
  offers            Offer[]
  sellers           PropertySeller[]
  dueDiligenceItems DueDiligenceItem[]
  portfolioHoldings PortfolioHolding[]
  ownerFinanceNotes OwnerFinanceNote[]
  communicationLogs CommunicationLog[]
  tracts            TractParcel[]

  @@index([apn, county, state])
  @@index([lifecycleStage])
  @@map("properties")
}

model Comp {
  id                     String    @id @default(uuid()) @db.Uuid
  propertyId             String?   @map("property_id") @db.Uuid
  property               Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  apn                    String
  address                String?
  county                 String
  state                  String
  acreage                Float
  salePrice              Float     @map("sale_price")
  saleDate               DateTime  @map("sale_date")
  pricePerAcre           Float     @map("price_per_acre")
  distanceMiles          Float     @map("distance_miles")
  roadAccess             String    @default("UNKNOWN") @map("road_access")
  utilities              String    @default("UNKNOWN")
  wetlandsPercentage     Float     @default(0) @map("wetlands_percentage")
  floodPercentage        Float     @default(0) @map("flood_percentage")
  isArmLengthTransaction Boolean   @default(true) @map("is_arm_length_transaction")
  isDuplicate            Boolean   @default(false) @map("is_duplicate")
  isFamilyTransfer       Boolean   @default(false) @map("is_family_transfer")
  isQuitclaim            Boolean   @default(false) @map("is_quitclaim")
  isOutlier              Boolean   @default(false) @map("is_outlier")
  exclusionReason        String?   @map("exclusion_reason")
  includedInValuation    Boolean   @default(true) @map("included_in_valuation")
  adjustments            Json?     @default("{}")
  adjustedPricePerAcre   Float?    @map("adjusted_price_per_acre")
  adjustedSalePrice      Float?    @map("adjusted_sale_price")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([county, state])
  @@map("comps")
}

model Seller {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @default("org_default") @map("organization_id")
  name             String
  email            String?
  phone            String?
  mailingAddress   String?               @map("mailing_address")
  motivationLevel  SellerMotivationLevel @default(MEDIUM) @map("motivation_level")
  askingPrice      Float?                @map("asking_price")
  reasonForSelling String?               @map("reason_for_selling")
  desiredTiming    String?               @map("desired_timing")
  notes            String[]              @default([])
  consent          Json?                 @default("[]")
  campaignId       String?               @map("campaign_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties        PropertySeller[]
  offers            Offer[]
  communicationLogs CommunicationLog[]

  @@map("sellers")
}

model PropertySeller {
  propertyId String   @map("property_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([propertyId, sellerId])
  @@map("property_sellers")
}

model Offer {
  id                  String           @id @default(uuid()) @db.Uuid
  propertyId          String           @map("property_id") @db.Uuid
  sellerId            String           @map("seller_id") @db.Uuid
  property            Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seller              Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  version             Int              @default(1)
  status              OfferStatus      @default(DRAFT)
  scenarios           Json             @default("{}")
  selectedScenarioKey String           @default("cash") @map("selected_scenario_key")
  approvedById        String?          @map("approved_by_id")
  approvedAt          DateTime?        @map("approved_at")
  sentAt              DateTime?        @map("sent_at")
  expiresAt           DateTime?        @map("expires_at")
  documentUrl         String?          @map("document_url")
  eSignatureStatus    ESignatureStatus @default(NOT_SENT) @map("esignature_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([sellerId])
  @@map("offers")
}

model Buyer {
  id                       String  @id @default(uuid()) @db.Uuid
  organizationId           String  @default("org_default") @map("organization_id")
  name                     String
  email                    String
  phone                    String?
  verifiedBuyer            Boolean @default(false) @map("verified_buyer")
  proofOfFundsVerified     Boolean @default(false) @map("proof_of_funds_verified")
  criteria                 Json    @default("{}")
  purchasedPropertiesCount Int     @default(0) @map("purchased_properties_count")
  unsubscribed             Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("buyers")
}

model DueDiligenceItem {
  id                 String            @id @default(uuid()) @db.Uuid
  propertyId         String            @map("property_id") @db.Uuid
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category           DiligenceCategory
  title              String
  description        String
  status             DiligenceStatus   @default(PENDING)
  isBlocker          Boolean           @default(false) @map("is_blocker")
  assignedToUser     String?           @map("assigned_to_user")
  dueDate            DateTime?         @map("due_date")
  verificationSource String?           @map("verification_source")
  evidenceNotes      String?           @map("evidence_notes")
  evidenceFileUrls   String[]          @default([]) @map("evidence_file_urls")
  reviewedBy         String?           @map("reviewed_by")
  reviewedAt         DateTime?         @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([status])
  @@map("due_diligence_items")
}

model PortfolioHolding {
  id                    String                 @id @default(uuid()) @db.Uuid
  propertyId            String                 @map("property_id") @db.Uuid
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  apn                   String
  address               String?
  county                String
  state                 String
  acreage               Float
  acquisitionDate       DateTime               @map("acquisition_date")
  purchasePrice         Float                  @map("purchase_price")
  closingCosts          Float                  @default(0) @map("closing_costs")
  holdingCosts          Float                  @default(0) @map("holding_costs")
  totalCostBasis        Float                  @map("total_cost_basis")
  estimatedCurrentValue Float                  @map("estimated_current_value")
  unrealizedProfit      Float                  @map("unrealized_profit")
  holdingDays           Int                    @default(0) @map("holding_days")
  status                PortfolioHoldingStatus @default(OWNED)

  notes OwnerFinanceNote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([status])
  @@map("portfolio_holdings")
}

model OwnerFinanceNote {
  id                      String           @id @default(uuid()) @db.Uuid
  portfolioHoldingId      String           @map("portfolio_holding_id") @db.Uuid
  portfolioHolding        PortfolioHolding @relation(fields: [portfolioHoldingId], references: [id], onDelete: Cascade)
  propertyId              String           @map("property_id") @db.Uuid
  property                Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerName               String           @map("buyer_name")
  buyerEmail              String           @map("buyer_email")
  terms                   Json
  startDate               DateTime         @map("start_date")
  nextPaymentDueDate      DateTime         @map("next_payment_due_date")
  currentBalance          Float            @map("current_balance")
  status                  NoteStatus       @default(ACTIVE)
  paymentsReceivedCount   Int              @default(0) @map("payments_received_count")
  totalInterestCollected  Float            @default(0) @map("total_interest_collected")
  totalPrincipalCollected Float            @default(0) @map("total_principal_collected")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([portfolioHoldingId])
  @@index([status])
  @@map("owner_finance_notes")
}

model CommunicationLog {
  id                String                 @id @default(uuid()) @db.Uuid
  sellerId          String                 @map("seller_id") @db.Uuid
  seller            Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  propertyId        String?                @map("property_id") @db.Uuid
  property          Property?              @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  channel           CommunicationChannel
  direction         CommunicationDirection
  content           String
  status            CommunicationStatus    @default(SENT)
  providerMessageId String?                @map("provider_message_id")
  sentByUserId      String?                @map("sent_by_user_id")
  timestamp         DateTime               @default(now())

  @@index([sellerId])
  @@index([propertyId])
  @@map("communication_logs")
}

// -------------------------------------------------------------
// LANDMAN OPERATING MODE MODELS
// -------------------------------------------------------------

model LandProject {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @default("org_default") @map("organization_id")
  projectName    String @map("project_name")

  clientId   String?        @map("client_id") @db.Uuid
  client     ProjectClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName String         @map("client_name") // Kept for legacy support until fully migrated

  projectType           LandProjectType @map("project_type")
  state                 String
  county                String
  basin                 String?
  play                  String?
  targetGrossAcres      Float           @default(0) @map("target_gross_acres")
  targetNetMineralAcres Float           @default(0) @map("target_net_mineral_acres")
  budgetUsd             Float           @default(0) @map("budget_usd")
  status                String          @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tracts LandTract[]

  @@map("land_projects")
}

model LandTract {
  id                       String          @id @default(uuid()) @db.Uuid
  projectId                String          @map("project_id") @db.Uuid
  project                  LandProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tractNumber              String          @map("tract_number")
  clientTractRef           String?         @map("client_tract_ref")
  county                   String
  state                    String
  legalDescription         String          @map("legal_description")
  grossAcres               Float           @default(0) @map("gross_acres")
  grossMineralAcres        Float           @default(0) @map("gross_mineral_acres")
  netMineralAcres          Float           @default(0) @map("net_mineral_acres")
  surfaceAcres             Float           @default(0) @map("surface_acres")
  formationName            String?         @map("formation_name")
  surfaceOwnerName         String          @map("surface_owner_name")
  mineralOwnerName         String          @map("mineral_owner_name")
  executiveRightsOwnerName String          @map("executive_rights_owner_name")
  leaseholdStatus          LeaseholdStatus @default(OPEN_UNLEASED) @map("leasehold_status")
  hbpStatus                HbpStatus       @default(NOT_HBP) @map("hbp_status")
  titleStatus              TitleStatus     @default(CLEAR) @map("title_status")
  status                   String          @default("ASSIGNED")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  runsheet         TitleRunsheet?
  leases           LeaseRecord[]
  curativeItems    CurativeItem[]
  titleInstruments TitleInstrument[]

  tractOwnerships TractOwnership[]
  tractParcels    TractParcel[]

  @@index([projectId])
  @@map("land_tracts")
}

model TitleInstrument {
  id                  String         @id @default(uuid()) @db.Uuid
  tractId             String         @map("tract_id") @db.Uuid
  tract               LandTract      @relation(fields: [tractId], references: [id], onDelete: Cascade)
  entryNumber         Int            @map("entry_number")
  instrumentType      InstrumentType @map("instrument_type")
  grantor             String
  grantee             String
  executionDate       DateTime       @map("execution_date")
  recordingDate       DateTime       @map("recording_date")
  bookPageDoc         String         @map("book_page_doc")
  legalDescription    String         @map("legal_description")
  conveyedNumerator   Int            @default(1) @map("conveyed_numerator")
  conveyedDenominator Int            @default(1) @map("conveyed_denominator")
  hasGapOrDefect      Boolean        @default(false) @map("has_gap_or_defect")
  defectNotes         String?        @map("defect_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tractId])
  @@map("title_instruments")
}

model TitleRunsheet {
  id               String    @id @default(uuid()) @db.Uuid
  tractId          String    @unique @map("tract_id") @db.Uuid
  tract            LandTract @relation(fields: [tractId], references: [id], onDelete: Cascade)
  titleLandmanName String    @map("title_landman_name")
  status           String    @default("DRAFT")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("title_runsheets")
}

model LeaseRecord {
  id                       String    @id @default(uuid()) @db.Uuid
  tractId                  String    @map("tract_id") @db.Uuid
  tract                    LandTract @relation(fields: [tractId], references: [id], onDelete: Cascade)
  leaseNumber              String    @map("lease_number")
  lessorName               String    @map("lessor_name")
  lesseeName               String    @map("lessee_name")
  effectiveDate            DateTime  @map("effective_date")
  primaryTermYears         Int       @default(3) @map("primary_term_years")
  expirationDate           DateTime  @map("expiration_date")
  bonusPerNma              Float     @default(0) @map("bonus_per_nma")
  royaltyNumerator         Int       @default(1) @map("royalty_numerator")
  royaltyDenominator       Int       @default(5) @map("royalty_denominator")
  hasPughClause            Boolean   @default(true) @map("has_pugh_clause")
  hasShutInClause          Boolean   @default(true) @map("has_shut_in_clause")
  hasContinuousDevelopment Boolean   @default(false) @map("has_continuous_development")
  status                   String    @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tractId])
  @@map("lease_records")
}

model CurativeItem {
  id                   String           @id @default(uuid()) @db.Uuid
  tractId              String           @map("tract_id") @db.Uuid
  tract                LandTract        @relation(fields: [tractId], references: [id], onDelete: Cascade)
  titleRequirement     String           @map("title_requirement")
  defectCategory       String           @map("defect_category")
  severity             CurativeSeverity @default(MAJOR)
  status               CurativeStatus   @default(OPEN)
  assignedTo           String           @map("assigned_to")
  targetCompletionDate DateTime?        @map("target_completion_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tractId])
  @@map("curative_items")
}

model RightOfWaySegment {
  id                   String  @id @default(uuid()) @db.Uuid
  projectId            String  @map("project_id") @db.Uuid
  segmentName          String  @map("segment_name")
  infrastructureType   String  @map("infrastructure_type")
  centerlineLengthRods Float   @map("centerline_length_rods")
  easementWidthFeet    Float   @map("easement_width_feet")
  permanentAcres       Float   @map("permanent_acres")
  temporaryAcres       Float   @map("temporary_acres")
  pricePerRodUsd       Float   @map("price_per_rod_usd")
  surfaceDamageUsd     Float   @map("surface_damage_usd")
  cropDamageUsd        Float   @map("crop_damage_usd")
  totalOfferUsd        Float   @map("total_offer_usd")
  easementSigned       Boolean @default(false) @map("easement_signed")
  condemnationRisk     Boolean @default(false) @map("condemnation_risk")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("right_of_way_segments")
}

model RenewableProject {
  id                        String @id @default(uuid()) @db.Uuid
  organizationId            String @default("org_default") @map("organization_id")
  projectName               String @map("project_name")
  technologyType            String @map("technology_type")
  targetControlAcres        Float  @map("target_control_acres")
  signedControlAcres        Float  @map("signed_control_acres")
  siteControlPercentage     Float  @map("site_control_percentage")
  interconnectionSubstation String @map("interconnection_substation")
  distanceToSubstationMiles Float  @map("distance_to_substation_miles")
  optionTermYears           Int    @map("option_term_years")
  optionRentPerAcYr         Float  @map("option_rent_per_ac_yr")
  operatingRentPerAcYr      Float  @map("operating_rent_per_ac_yr")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("renewable_projects")
}

model LandmanBillingEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  landmanName            String   @map("landman_name")
  date                   DateTime
  hoursWorked            Float    @map("hours_worked")
  hourlyRateUsd          Float    @map("hourly_rate_usd")
  mileageMiles           Float    @map("mileage_miles")
  mileageRateUsd         Float    @map("mileage_rate_usd")
  perDiemUsd             Float    @map("per_diem_usd")
  outOfPocketExpensesUsd Float    @map("out_of_pocket_expenses_usd")
  expenseCategory        String   @map("expense_category")
  totalBilledUsd         Float    @map("total_billed_usd")
  invoiceStatus          String   @default("UNBILLED") @map("invoice_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("landman_billing_entries")
}

// -------------------------------------------------------------
// LANDMAN EXPANSION MODELS (PHASE L1)
// -------------------------------------------------------------

model ProjectClient {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @default("org_default") @map("organization_id")
  name           String
  contactName    String? @map("contact_name")
  contactEmail   String? @map("contact_email")
  billingDetails Json?   @default("{}") @map("billing_details")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects LandProject[]

  @@map("project_clients")
}

model TractParcel {
  tractId    String    @map("tract_id") @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  tract      LandTract @relation(fields: [tractId], references: [id], onDelete: Cascade)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // To support tracts covering only a part of a parcel
  fractionOfParcel Float @default(1.0) @map("fraction_of_parcel")

  @@id([tractId, propertyId])
  @@map("tract_parcels")
}

model Estate {
  id          String     @id @default(uuid()) @db.Uuid
  type        EstateType
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tractOwnerships TractOwnership[]

  @@map("estates")
}

model TractOwnership {
  id       String    @id @default(uuid()) @db.Uuid
  tractId  String    @map("tract_id") @db.Uuid
  tract    LandTract @relation(fields: [tractId], references: [id], onDelete: Cascade)
  estateId String    @map("estate_id") @db.Uuid
  estate   Estate    @relation(fields: [estateId], references: [id], onDelete: Cascade)

  ownerName String @map("owner_name")

  // Rational math storage
  numerator    BigInt @default(1)
  denominator  BigInt @default(1)
  decimalValue Float  @map("decimal_value")

  netMineralAcres Float?  @map("net_mineral_acres")
  depthSeverance  String? @map("depth_severance")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tractId])
  @@index([estateId])
  @@map("tract_ownerships")
}
